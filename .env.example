# --- required in production (docker compose refuses to start without them)
POSTGRES_PASSWORD=change-me-long-random
NEO4J_PASSWORD=change-me-long-random
# python -c "import secrets;print(secrets.token_urlsafe(48))"
PT_JWT_SECRET=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing this key makes stored GitHub credentials unrecoverable.
PT_ENCRYPTION_KEY=
PT_CORS_ORIGINS=["https://pipelinetrust.example.com"]

# --- optional AI agents (the scanner is fully functional without them)
# none | anthropic | openai
PT_LLM_PROVIDER=none
# default: claude-opus-5-5 (anthropic) / gpt-4.1 (openai)
PT_LLM_MODEL=
PT_ANTHROPIC_API_KEY=
PT_OPENAI_API_KEY=

# --- local development (no Docker): leave PT_DATABASE_URL / PT_REDIS_URL / PT_NEO4J_URI unset
# to use SQLite, the in-process job runner and the in-memory attack graph.
# PT_TOOLS_DIR=E:\tools\pt-bin
# PT_FRONTEND_DIR=E:\pipelinetrust\frontend\out
